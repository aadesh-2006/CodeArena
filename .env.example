# =============================================================================
# CodeArena Environment Configuration Template
# Copy this file to .env and adjust values for local development.
# =============================================================================

# Backend Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
POSTGRES_DB=codearena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/codearena
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Security Configuration (Required in Milestone 2)
JWT_SECRET=replace_with_a_secure_256_bit_random_secret_string_minimum_32_chars
JWT_EXPIRATION_MS=86400000

# Future Execution Engine Configuration (Milestone 5)
EXECUTION_ENGINE_URL=http://localhost:2358
EXECUTION_ENGINE_TIMEOUT_MS=5000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
